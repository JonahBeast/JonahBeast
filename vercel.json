{
  "redirects": [
    {
      "source": "/:ruta((?!api/|\\.well-known/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.jonahbeast.com"
        }
      ],
      "destination": "https://jonahbeast.com/:ruta",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/verificar-alimentos",
      "schedule": "5 14 * * 1"
    },
    {
      "path": "/api/cron/recordatorio",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/alertas-admin",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/lista-carino-aviso",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/whatsapp-seguimiento",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/alimentos-revision",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/racha-en-riesgo",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/plan-por-vencer",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/reto-semanal",
      "schedule": "0 23 * * 6"
    },
    {
      "path": "/api/cron/equipos-cierre",
      "schedule": "10 13 * * *"
    },
    {
      "path": "/api/cron/control-quincenal",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/embudo-historico",
      "schedule": "59 4 * * *"
    },
    {
      "path": "/api/cron/activa-tu-perfil",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/cron/renovaciones-google",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/resumen-semanal",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/pesaje-semanal",
      "schedule": "0 12 * * 0"
    },
    {
      "path": "/api/cron/informe-admin",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/prueba-guiada",
      "schedule": "15 23 * * *"
    },
    {
      "path": "/api/cron/manual-jarvis",
      "schedule": "40 * * * *"
    }
  ],
  "functions": {
    "api/cron/manual-jarvis.js": {
      "includeFiles": "docs/manual-app.md"
    }
  }
}
